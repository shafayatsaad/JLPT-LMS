{
  "name": "jlpt-practice-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "supabase:config:validate": "supabase config validate",
    "supabase:db:reset": "supabase db reset --no-seed",
    "supabase:db:reset:demo": "supabase db reset --sql-paths ./seed.sql",
    "demo:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-demo.ps1",
    "demo:local:resume": "powershell -ExecutionPolicy Bypass -File scripts/start-local-demo.ps1 -Resume",
    "demo:local:production": "powershell -ExecutionPolicy Bypass -File scripts/start-local-demo.ps1 -Production",
    "demo:local:production:resume": "powershell -ExecutionPolicy Bypass -File scripts/start-local-demo.ps1 -Production -Resume",
    "demo:local:docker": "powershell -ExecutionPolicy Bypass -File scripts/start-local-docker-app.ps1",
    "demo:local:docker:lan": "powershell -ExecutionPolicy Bypass -File scripts/start-local-docker-app.ps1 -Lan",
    "demo:local:docker:remote": "powershell -ExecutionPolicy Bypass -File scripts/start-local-docker-remote.ps1",
    "demo:local:docker:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-local-docker-app.ps1 -Stop",
    "supabase:test": "supabase test db",
    "supabase:audit": "node scripts/audit-supabase-schema.cjs",
    "supabase:content-audit": "node scripts/audit-published-exams.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "exceljs": "4.4.0",
    "google-auth-library": "11.3.4",
    "jszip": "^3.10.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "supabase": "3.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
