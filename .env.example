NEXT_PUBLIC_SUPABASE_URL=https://sjgyrmgaayvzfzunvciz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oYMzJIw9nZ_3ofkx49VMrQ_IXFt26be
NEXT_PUBLIC_AUTH_ENABLE_PHONE=false

# Enable only after applying migration 032 and enabling the Supabase Custom
# Access Token Hook in Preview. The hook gates accounts with verified TOTP.
SUPABASE_TOTP_STEP_UP_ENABLED=false

# Server-only. Used by private image upload routes and the disabled Sheets worker.
# Never prefix this with NEXT_PUBLIC_ or expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets sync stays disabled until the owner supplies a destination and
# the target sheet is shared with the dedicated service account.
# Set these only in server-side environment settings (for example, Vercel).
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Payments
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Vercel Cron Authorization header for the retry-safe server sync endpoint.
# Generate a long random value and set it in Preview/Production separately.
CRON_SECRET=
